<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
	<file original="" product-name="UpAssist.Neos.UserAvatar" source-language="en" datatype="plaintext">
		<body>
			<trans-unit id="module.label" xml:space="preserve">
				<source>Profile photo</source>
			</trans-unit>
			<trans-unit id="module.description" xml:space="preserve">
				<source>Upload or remove the photo that Neos shows for your user.</source>
			</trans-unit>
			<trans-unit id="module.heading" xml:space="preserve">
				<source>Profile photo</source>
			</trans-unit>
			<trans-unit id="module.none" xml:space="preserve">
				<source>You have no profile photo yet. Neos shows your initials.</source>
			</trans-unit>
			<trans-unit id="module.gravatarActive" xml:space="preserve">
				<source>This photo comes from Gravatar.</source>
			</trans-unit>
			<trans-unit id="module.upload" xml:space="preserve">
				<source>Upload a photo</source>
			</trans-unit>
			<trans-unit id="module.uploadHelp" xml:space="preserve">
				<source>JPEG or PNG. The photo is cropped to a square from the centre.</source>
			</trans-unit>
			<trans-unit id="module.save" xml:space="preserve">
				<source>Save photo</source>
			</trans-unit>
			<trans-unit id="module.remove" xml:space="preserve">
				<source>Remove photo</source>
			</trans-unit>
			<trans-unit id="module.gravatarHelp" xml:space="preserve">
				<source>Without an uploaded photo, Neos uses the Gravatar of {0}.</source>
			</trans-unit>
			<trans-unit id="module.gravatarNoEmail" xml:space="preserve">
				<source>Gravatar is enabled, but your user has no e-mail address.</source>
			</trans-unit>
			<trans-unit id="message.noFile" xml:space="preserve">
				<source>Choose a photo first.</source>
			</trans-unit>
			<trans-unit id="message.saved" xml:space="preserve">
				<source>Your profile photo is saved.</source>
			</trans-unit>
			<trans-unit id="message.invalidFile" xml:space="preserve">
				<source>This file cannot be used as a photo. Use a JPEG or PNG image.</source>
			</trans-unit>
			<trans-unit id="message.removed" xml:space="preserve">
				<source>Your profile photo is removed.</source>
			</trans-unit>
		</body>
	</file>
</xliff>
