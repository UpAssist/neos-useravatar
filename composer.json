{
    "name": "upassist/neos-useravatar",
    "description": "Profile photo (upload or Gravatar) for Neos backend users, shown in the Neos UI and the backend modules instead of the initials or user icon",
    "type": "neos-package",
    "license": "MIT",
    "keywords": [
        "neos",
        "neos-ui",
        "avatar",
        "gravatar",
        "profile photo"
    ],
    "homepage": "https://github.com/UpAssist/neos-useravatar",
    "support": {
        "issues": "https://github.com/UpAssist/neos-useravatar/issues",
        "source": "https://github.com/UpAssist/neos-useravatar"
    },
    "require": {
        "php": "^8.1",
        "neos/neos": "^8.3 || ^9.0",
        "neos/neos-ui": "^8.3 || ^9.0",
        "neos/media": "^8.3 || ^9.0",
        "imagine/imagine": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "UpAssist\\Neos\\UserAvatar\\": "Classes"
        }
    },
    "extra": {
        "neos": {
            "package-key": "UpAssist.Neos.UserAvatar"
        }
    }
}
